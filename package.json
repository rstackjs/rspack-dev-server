{
  "name": "@rspack/dev-server",
  "version": "2.2.1",
  "description": "Development server for Rspack",
  "homepage": "https://github.com/rstackjs/rspack-dev-server",
  "bugs": "https://github.com/rstackjs/rspack-dev-server/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/rspack-dev-server"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client/*.js": "./client/*.js",
    "./client/*": "./client/*.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "client"
  ],
  "scripts": {
    "build": "rs lib",
    "bump": "pnpx bumpp",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "test": "pnpm run test:type && rs test",
    "test:type": "pnpm run build && pnpm --dir tests run type-check"
  },
  "dependencies": {
    "@rspack/dev-middleware": "^2.0.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@rspack/core": "2.2.2",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/mime-types": "3.0.1",
    "@types/node": "^24.13.3",
    "@types/serve-static": "^2.2.0",
    "@types/trusted-types": "^2.0.7",
    "@types/ws": "8.18.1",
    "chokidar": "^5.0.0",
    "connect-history-api-fallback": "^2.0.0",
    "connect-next": "^5.0.0",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "hono": "^4.13.5",
    "http-compression": "^1.1.3",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "4.2.0",
    "ipaddr.js": "^2.5.0",
    "launch-editor": "^2.14.1",
    "open": "^11.0.2",
    "p-retry": "^7.1.1",
    "prettier": "3.9.6",
    "puppeteer": "^24.43.1",
    "react-refresh": "0.18.0",
    "require-from-string": "^2.0.2",
    "rstack": "^0.7.2",
    "selfsigned": "^5.5.0",
    "serve-static": "^2.2.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0",
    "selfsigned": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "selfsigned": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
